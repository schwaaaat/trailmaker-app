{
  "name": "trailmaker",
  "version": "1.7.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "pnpm typecheck && vite build",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.app.json && tsc -p tsconfig.tools.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run --coverage && pnpm test:kmz-stress",
    "test:kmz-stress": "vitest run --config vitest.kmz-stress.config.ts",
    "test:e2e": "playwright test && playwright test --config playwright.preview.config.ts",
    "test:e2e:pages": "playwright test --config playwright.pages.config.ts",
    "test:trace-bench": "tsx tests/bench/run.ts",
    "fixtures": "tsx tests/fixtures/generate.ts",
    "gate": "pnpm typecheck && pnpm lint && pnpm test && pnpm fixtures && pnpm test:e2e && pnpm test:e2e:pages && pnpm test:trace-bench && pnpm build"
  },
  "dependencies": {
    "comlink": "^4.4.2",
    "fflate": "^0.8.2",
    "idb": "^8.0.3",
    "maplibre-gl": "^6.11.2",
    "pdfjs-dist": "^5.4.149",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "libxml2-wasm": "0.7.2",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.6.2",
    "sharp": "^0.34.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
